{
  "name": "copaint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:backend": "tsc --noEmit",
    "typecheck:frontend": "tsc -p src/frontend/tsconfig.json --noEmit",
    "build:frontend": "node script/build-frontend.mjs",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "konva": "^9.3.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-konva": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.112.0"
  }
}
